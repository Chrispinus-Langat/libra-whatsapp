NODE_ENV=production
PORT=4000
DOMAIN=chat.yourdomain.com
PUBLIC_IP=203.0.113.10
CLIENT_ORIGIN=https://chat.yourdomain.com
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=verify-full
JWT_SECRET=paste-a-long-random-string-here

# Login codes by SMS: africastalking | twilio
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=false
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=+1...

# Push notifications (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Calls across different networks (coturn container). Use a long random string.
TURN_SECRET=
TURN_URL=chat.yourdomain.com

DEFAULT_CC=254
